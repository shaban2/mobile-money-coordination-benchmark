PORT=8080
COORDINATION_MODE=rest
CLIENT_MODE=async
PROVIDER_DELAY_MS=10
PERSISTENCE_TYPE=postgres
EVENT_BUS_TYPE=memory
KAFKA_BROKERS=localhost:9092
EVENT_NAMESPACE=rest-async
DATABASE_URL=postgres://experiment:experiment@localhost:15432/experiment
DEFAULT_PAYER_BALANCE=100000000
ADAPTER_BASE_URL=http://localhost:8095
ADAPTER_CRASH_SECONDS=30
TOXIPROXY_URL=http://localhost:8474
DATABASE_LATENCY_MS=100
EXPERIMENT_CONDITION=R-A
SEND_HTTP_CALLBACKS=true
